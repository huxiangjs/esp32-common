#
# Build-time version info for an app (CMake port of the ESP8266 project's
# Makefile git_version.h rule).
#
# Invoked from the app's main/CMakeLists.txt as a build-time command:
#
#   COMMAND ${CMAKE_COMMAND}
#           -DGIT_REPO=<app repo dir> -DOUT_FILE=<header path>
#           -P <this file>
#
# Writes the git state of <app repo dir> at build time into <header path>:
#   - APP_GIT_BRANCH  git branch at build time
#   - APP_GIT_SHA     short sha at build time
#   - APP_GIT_DIRTY   "-dirty" when the working tree has uncommitted changes
#
# The header is only rewritten when its content changes, so its timestamp
# - and thus the rebuild of the objects that include it - changes exactly
# when the git state (branch/sha/dirty) changes. This keeps the embedded
# version up to date with incremental builds (a configure-time stamp or a
# plain -D flag would go stale). The macros are empty strings when git is
# not available at build time.
#
if(NOT DEFINED GIT_REPO OR NOT DEFINED OUT_FILE)
    message(FATAL_ERROR "git_version.cmake requires -DGIT_REPO= and -DOUT_FILE=")
endif()

execute_process(COMMAND git -C ${GIT_REPO} rev-parse --abbrev-ref HEAD
                OUTPUT_VARIABLE git_branch
                OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
execute_process(COMMAND git -C ${GIT_REPO} rev-parse --short HEAD
                OUTPUT_VARIABLE git_sha
                OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
execute_process(COMMAND git -C ${GIT_REPO} status --porcelain
                OUTPUT_VARIABLE git_status
                OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
if(git_status)
    set(git_dirty "-dirty")
else()
    set(git_dirty "")
endif()

set(git_version_content
"/* Auto-generated by esp32-common/git_version.cmake, do not edit. */
#ifndef __GIT_VERSION_H_
#define __GIT_VERSION_H_
#define APP_GIT_BRANCH \"${git_branch}\"
#define APP_GIT_SHA \"${git_sha}\"
#define APP_GIT_DIRTY \"${git_dirty}\"
#endif
")

set(git_version_need_write 1)
if(EXISTS ${OUT_FILE})
    file(READ ${OUT_FILE} git_version_old)
    if(git_version_old STREQUAL git_version_content)
        set(git_version_need_write 0)
    endif()
endif()

if(git_version_need_write)
    get_filename_component(git_version_dir ${OUT_FILE} DIRECTORY)
    file(MAKE_DIRECTORY ${git_version_dir})
    file(WRITE ${OUT_FILE} ${git_version_content})
endif()
